        "print(\"\\n=== Predictions ===\")\n",
        "# Let's inspect active raters for Esha -> Match Point\n",
        "raters_match_point = R['Match Point'].dropna().index.difference(['Esha'])\n",
        "similarity_with_esha = sim_u.loc['Esha', raters_match_point].sort_values(ascending=False)\n",
        "print(f\"Raters for 'Match Point' and similarity to Esha:\\n{similarity_with_esha}\")\n",
        "pred_esha = predict_user_cf(R, means, sim_u, 'Esha', 'Match Point')\n",
        "print(f\"Prediction Esha -> Match Point: {pred_esha:.2f}\")\n",
        "\n",
        "# Let's inspect active raters for Dev -> Cricket Fever\n",
        "raters_cricket_fever = R['Cricket Fever'].dropna().index.difference(['Dev'])\n",
        "similarity_with_dev = sim_u.loc['Dev', raters_cricket_fever].sort_values(ascending=False)\n",
        "print(f\"\\nRaters for 'Cricket Fever' and similarity to Dev:\\n{similarity_with_dev}\")\n",
        "pred_dev = predict_user_cf(R, means, sim_u, 'Dev', 'Cricket Fever')\n",
        "print(f\"Prediction Dev -> Cricket Fever: {pred_dev:.2f}\")\n",
        "\n",
        "# 3. Item-based CF\n",
        "C = R.sub(R.mean(axis=1), axis=0).fillna(0) # Centred matrix\n",
        "S_item_cf = pd.DataFrame(cosine_similarity(C.T), index=R.columns, columns=R.columns)\n",
        "\n",
        "def predict_item_cf(u, m, k=3):\n",
        "    # Items rated by user u other than item m\n",
        "    rated_items = R.loc[u].dropna().index.difference([m])\n",
        "    # Similarities of rated items to item m\n",
        "    sims = S_item_cf.loc[m, rated_items].sort_values(ascending=False).head(k)\n",
        "    sims = sims[sims > 0]\n",
        "    if len(sims) == 0:\n",
        "        return R.mean(axis=1)[u]\n",
        "    return (sims * R.loc[u, sims.index]).sum() / sims.abs().sum()\n",
        "\n",
