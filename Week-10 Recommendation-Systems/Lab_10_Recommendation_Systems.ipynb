        "sim_esha_farid = sim_u.loc['Esha', 'Farid']\n",
        "\n",
        "# Mean-centered rating adjustments\n",
        "adj_bala = r_bala_match - mean_bala\n",
        "adj_farid = r_farid_match - mean_farid\n",
        "\n",
        "# Compute prediction\n",
        "predicted_score = mean_esha + ((sim_esha_bala * adj_bala) + (sim_esha_farid * adj_farid)) / (abs(sim_esha_bala) + abs(sim_esha_farid))\n",
        "\n",
